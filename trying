<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>BINI Official Site</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      transition: opacity 1s ease;
      background-color: #fafafa;
    }

    /* INTRO SECTION */
    .intro-section {
      background-color: #66cdd2;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 50px;
    }
    .logo {
      width: 150px;
      height: auto;
      animation: spin 5s linear infinite, bounce 2s ease-in-out infinite;
      filter: drop-shadow(0 0 20px #ffb6f0);
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(180deg); }
    }
    .switch-container {
      position: relative;
      width: 80px;
      height: 40px;
    }
    .switch-input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .switch-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #ccc;
      border-radius: 40px;
      transition: 0.4s;
      box-shadow: 0 0 0px #ff89e9;
    }
    .switch-slider::before {
      position: absolute;
      content: "";
      height: 30px;
      width: 30px;
      left: 5px;
      bottom: 5px;
      background-color: rgb(237, 237, 237);
      transition: 0.4s;
      border-radius: 50%;
    }
    .switch-container:hover .switch-slider {
      box-shadow: 0 0 15px #ff89e9;
    }
    .switch-input:checked + .switch-slider {
      background-color: #ff89e9;
    }
    .switch-input:checked + .switch-slider::before {
      transform: translateX(40px);
    }

    /* MAIN CONTENT SECTION */
    .main-content {
      display: none;
      opacity: 0;
      transition: opacity 1s ease;
      padding: 0 30px;
    }

    header {
      background-color: #fff;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #ccc;
    }
    .logo-title {
      font-size: 24px;
      font-weight: bold;
    }
    nav {
      display: flex;
      gap: 20px;
      align-items: center;
    }
    nav a {
      text-decoration: none;
      color: #000;
      padding: 8px 12px;
      border-radius: 8px;
    }
    nav a.active {
      background-color: #ccc;
      font-weight: bold;
    }
    .search-box {
      padding: 6px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .hero {
      background-color: #555;
      color: white;
      padding: 40px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .hero-text {
      max-width: 600px;
    }
    .hero-text h1 {
      font-size: 32px;
    }
    .tag {
      display: inline-block;
      background-color: #888;
      color: white;
      padding: 4px 8px;
      margin-right: 5px;
      border-radius: 4px;
      font-size: 12px;
    }
    .explore-btn {
      background-color: black;
      color: white;
      padding: 12px 20px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }

    .slider-section {
      padding: 50px 20px;
      text-align: center;
    }
    .slider-box {
      background-color: #eee;
      margin: 0 auto;
      max-width: 800px;
      padding: 40px;
      border-radius: 12px;
    }
    .dots {
      margin-top: 15px;
    }
    .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      margin: 0 4px;
      background-color: #ccc;
      border-radius: 50%;
    }
    .dot.active {
      background-color: #999;
    }

    /* GALLERY SECTION */
    h2, p {
      text-align: center;
      margin: 0;
    }
    .gallery-title {
      margin-top: 80px;
    }
    p {
      margin-top: 10px;
      font-style: italic;
      color: #c0c0c0;
    }
    .gallery {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
      margin-top: 40px;
      padding-bottom: 50px;
    }
    .card {
      position: relative;
      width: 250px;
      height: 400px;
      border-radius: 20px;
      overflow: hidden;
      background-color: #000;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      text-align: center;
      color: white;
    }
    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .overlay {
      position: absolute;
      bottom: 0;
      width: 100%;
      background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));
      padding: 20px 10px 30px 10px;
      box-sizing: border-box;
    }
    .overlay h3 {
      margin: 0;
      font-size: 24px;
      font-weight: bold;
    }
    .overlay p {
      font-size: 12px;
      margin: 5px 0 10px;
    }
    .learn-more {
      background: white;
      color: black;
      padding: 8px 16px;
      border-radius: 30px;
      font-weight: bold;
      text-decoration: none;
      display: inline-block;
      font-size: 14px;
      margin-top: 5px;
      transition: background 0.3s;
    }
    .learn-more:hover {
      background: #eee;
    }
  </style>
